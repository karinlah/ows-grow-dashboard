# להעתיק לקובץ בשם .env (לא נכנס ל-git) ולמלא.

# --- כניסה לדשבורד ---
ADMIN_NAME=קארין
ADMIN_EMAIL=hello@onewomanshowacademy.com
ADMIN_PASSWORD=ows

# --- תיבת המייל שאליה מגיעים מיילי Grow ---
# IMAP_PASS היא "סיסמת אפליקציה" של גוגל, לא הסיסמה הרגילה:
# https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# כל כמה דקות לסרוק את התיבה
INGEST_INTERVAL_MINUTES=15

# --- שרת ---
PORT=3100
SESSION_SECRET=
